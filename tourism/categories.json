 "roles": {
  "$comment": "Delivery presets. aspect drives width/height + CSS aspect-ratio (no layout shift). width is the CDN target for the 1x slot; srcset multiplies it. sizes is the browser hint. eager+priority only for above-the-fold heroes.",
  "hero": {
   "aspect": [
