  "roles": {
    "$comment": "Delivery presets. aspect drives width/height + CSS aspect-ratio (no layout shift). width is the CDN target for the 1x slot; srcset multiplies it. sizes is the browser hint. eager+priority only for above-the-fold heroes.",
    "hero":      { "aspect": [16, 9],  "width": 2400, "srcset": [1200, 1800, 2400, 3000], "sizes": "100vw",                                                        "loading": "eager", "priority": true,  "quality": 82 },
    "feature":   { "aspect": [16, 9],  "width": 1800, "srcset": [900, 1400, 1800, 2400],  "sizes": "(min-width: 1240px) 1152px, 100vw",                             "loading": "lazy",  "priority": false, "quality": 82 },
    "card":      { "aspect": [4, 3],   "width": 1000, "srcset": [500, 750, 1000, 1400],   "sizes": "(min-width: 1000px) 368px, (min-width: 640px) 45vw, 92vw",      "loading": "lazy",  "priority": false, "quality": 80 },
    "portrait":  { "aspect": [3, 4],   "width": 1000, "srcset": [500, 750, 1000, 1400],   "sizes": "(min-width: 1000px) 368px, (min-width: 640px) 45vw, 92vw",      "loading": "lazy",  "priority": false, "quality": 80 },
    "panoramic": { "aspect": [21, 9],  "width": 2400, "srcset": [1200, 1800, 2400, 3000], "sizes": "100vw",                                                        "loading": "lazy",  "priority": false, "quality": 82 },
    "thumb":     { "aspect": [4, 3],   "width": 800,  "srcset": [400, 600, 800],          "sizes": "(min-width: 1000px) 240px, 40vw",                               "loading": "lazy",  "priority": false, "quality": 78 }
  }
