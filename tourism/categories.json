    3000
   ],
   "sizes": "100vw",
   "loading": "eager",
   "priority": true,
   "quality": 82,
   "focus": "the horizon and the landform that establishes the place",
   "mobile": {
    "aspect": [
     4,
     5
    ],
    "upTo": 700,
    "note": "A 16:9 band is forty pixels tall on a phone. Where a role says so, the same photograph is delivered in a taller crop below this width, cut around the same focal point."
   }
  },
