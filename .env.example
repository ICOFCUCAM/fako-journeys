# Unsplash API access key — free, https://unsplash.com/developers
# The Access Key, never the Secret key. Server-side only.
UNSPLASH_ACCESS_KEY=

# Pexels API key — free, https://www.pexels.com/api/
# Used as the fallback when Unsplash has no suitable photograph.
PEXELS_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys
# Used by `generate` (gpt-image-1) and by `intake --describe` (vision).
# Server-side only, like the two above: read by a CLI on a developer or CI
# machine, never written to the cache, never rendered into a page.
OPENAI_API_KEY=
